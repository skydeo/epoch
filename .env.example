# Host port the app is published on (compose maps EPOCH_PORT -> 8000 inside the
# container). Bound to 127.0.0.1 only; front it with `tailscale serve` for
# tailnet access. Pick any free port in the 1024–49151 range; 8193 is the
# memorable default.
EPOCH_PORT=8193

# Container user mapping — set these to your host user's UID/GID (run `id`) so
# the SQLite file written to ./data is owned by you on the host, not root.
PUID=1000
PGID=1000
